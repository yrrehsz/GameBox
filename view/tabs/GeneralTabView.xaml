<UserControl x:Class="GameBox.Views.GeneralTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="General"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,14"/>

            <!-- Windows startup card -->
            <Border Style="{StaticResource Win11SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Launch at Windows startup"
                                   Foreground="White" FontWeight="Medium" FontSize="14"/>
                        <TextBlock Text="Automatically start GameBox in the background when you sign in to Windows."
                                   Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,3,16,0"/>
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="TglLaunchAtStartup"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Click="TglLaunchAtStartup_Click"/>
                </Grid>
            </Border>

            <!-- Taskbar launcher location card -->
            <Border Style="{StaticResource Win11SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Taskbar Launcher Executable"
                                   Foreground="White" FontWeight="Medium" FontSize="14"/>
                        <TextBlock Text="Stored alongside your JSON settings in AppData. Windows 11 blocks silent auto-pinning for standalone apps; click Show in Explorer, right-click GameBox.exe, and choose Pin to taskbar."
                                   Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtLauncherPath"
                                   Foreground="#60CDFF"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ui:Button x:Name="BtnRevealLauncher"
                               Grid.Column="1"
                               Content="Show in Explorer"
                               Icon="{ui:SymbolIcon Pin24}"
                               Appearance="Secondary"
                               VerticalAlignment="Center"
                               Click="BtnRevealLauncher_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
