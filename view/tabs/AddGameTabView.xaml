<UserControl x:Class="GameStartMenu.Views.AddGameTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Add a Game"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,14"/>

            <!-- Step 1: executable or script -->
            <Border Style="{StaticResource Win11SettingsCard}">
                <StackPanel>
                    <TextBlock Text="1. Game Executable or Script"
                               Foreground="White" FontWeight="Medium"/>
                    <TextBlock Text="Select the .exe, .bat, or shortcut file to launch the game"
                               Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtNewGameExe"
                                    Grid.Column="0"
                                    PlaceholderText="C:\Games\...\game.exe"
                                    Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="1"
                                   Content="Browse..."
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Appearance="Primary"
                                   Click="BtnBrowseNewGameExe_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 2: game title + normalised preview -->
            <Border Style="{StaticResource Win11SettingsCard}">
                <StackPanel>
                    <TextBlock Text="2. Game Title"
                               Foreground="White" FontWeight="Medium"/>
                    <TextBlock Text="The title will be automatically normalized to match your trophies and cloud data"
                               Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,10"/>

                    <ui:TextBox x:Name="TxtNewGameTitle"
                                PlaceholderText="e.g. Elden Ring, Bloodborne, Cyberpunk 2077..."
                                TextChanged="TxtNewGameTitle_TextChanged"/>

                    <TextBlock x:Name="TxtNormalizedPreview"
                               Text="Normalized ID: -"
                               Foreground="#60CDFF"
                               FontSize="11"
                               Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Step 3: cover options (auto-download vs. custom) -->
            <Border Style="{StaticResource Win11SettingsCard}">
                <StackPanel>
                    <CheckBox x:Name="ChkAutoDownloadCover"
                              Content="Automatically download game cover"
                              IsChecked="True"
                              Foreground="White"
                              FontWeight="Medium"
                              Checked="ChkAutoDownloadCover_Changed"
                              Unchecked="ChkAutoDownloadCover_Changed"/>
                    <TextBlock Text="Automatically searches and downloads a 600x900 vertical cover from Steam / SteamGridDB"
                               Foreground="#88FFFFFF" FontSize="11" Margin="28,2,0,0"/>

                    <!-- Custom cover panel (visible only when auto-download is unchecked) -->
                    <Border x:Name="CustomCoverPanel"
                            Visibility="Collapsed"
                            Background="#14FFFFFF"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="60" Height="90"
                                    CornerRadius="4"
                                    Background="#181818"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left">
                                <Image x:Name="ImgNewGameCustomCover" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                <TextBlock Text="Custom Cover Image" Foreground="White" FontWeight="Medium"/>
                                <TextBlock x:Name="TxtNewGameCoverPath"
                                           Text="No image selected (Recommended ratio: 600x900)"
                                           Foreground="#88FFFFFF"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <ui:Button Grid.Column="2"
                                       Content="Select Image..."
                                       Icon="{ui:SymbolIcon Image24}"
                                       VerticalAlignment="Center"
                                       Click="BtnBrowseNewGameCover_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Add to Library action bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock x:Name="TxtAddGameStatus"
                           Text=""
                           Foreground="#6CCB5F"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ui:Button x:Name="BtnConfirmAddGame"
                           Content="Add to Library"
                           Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary"
                           Padding="20,9"
                           Click="BtnConfirmAddGame_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
