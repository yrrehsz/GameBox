<UserControl x:Class="GameStartMenu.Views.AppearanceTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Appearance"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,14"/>

            <Border Style="{StaticResource Win11SettingsCard}">
                <StackPanel>
                    <TextBlock Text="100% Completion Cover Overlays"
                               Foreground="White" FontWeight="Medium" FontSize="14"/>
                    <TextBlock Text="Select which overlays can appear on completed games. The click order sets the priority (1, 2, 3) when a game is completed on multiple platforms."
                               Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,16"/>

                    <!-- Overlay tile checkboxes -->
                    <WrapPanel Orientation="Horizontal">

                        <!-- Xbox overlay -->
                        <CheckBox x:Name="ChkOverlayXbox"
                                  Style="{StaticResource Win11OverlayTileCheckBox}"
                                  Click="OverlayPlatformCheckBox_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/assets/icons/achievements/mythic_overlay.png"
                                       Width="187" Height="61"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Xbox Mythic Overlay"
                                           FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- PlayStation overlay -->
                        <CheckBox x:Name="ChkOverlayPs"
                                  Style="{StaticResource Win11OverlayTileCheckBox}"
                                  Click="OverlayPlatformCheckBox_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/assets/icons/achievements/platinum_overlay.png"
                                       Width="187" Height="61"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="PlayStation Platinum Overlay"
                                           FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Steam overlay -->
                        <CheckBox x:Name="ChkOverlaySteam"
                                  Style="{StaticResource Win11OverlayTileCheckBox}"
                                  Click="OverlayPlatformCheckBox_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/assets/icons/achievements/steam_overlay.png"
                                       Width="187" Height="61"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Steam 100% Ribbon Overlay"
                                           FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- No overlay -->
                        <CheckBox x:Name="ChkOverlayNone"
                                  Style="{StaticResource Win11OverlayTileCheckBox}"
                                  Tag="✓"
                                  Click="OverlayNoneCheckBox_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="187" Height="61"
                                        CornerRadius="6"
                                        Background="#0AFFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Prohibited24" FontSize="22"
                                                       Foreground="#99FFFFFF" Margin="0,0,8,0"/>
                                        <TextBlock Text="No Overlay"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#CCFFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="None (Show bottom icons only)"
                                           FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </CheckBox>

                    </WrapPanel>

                    <!-- Current priority summary -->
                    <Border Background="#12FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
                        <TextBlock x:Name="TxtOverlayPrioritySummary"
                                   Text="Active Priority: Xbox › PlayStation › Steam"
                                   Foreground="#60CDFF"
                                   FontSize="12" FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
