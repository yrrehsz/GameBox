<UserControl x:Class="GameStartMenu.Views.FooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Stile pulsante Windows 11 Start Footer: solo icona a riposo, quadrato arrotondato in hover -->
        <Style x:Key="Win11FooterIconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBox"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBox" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="BtnBox" Property="BorderBrush" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBox" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#AAFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile identico per il pulsante del Controller (Adattato alla dimensione dell'immagine + LED) -->
        <Style x:Key="Win11ControllerButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CtrlBox"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CtrlBox" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="CtrlBox" Property="BorderBrush" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CtrlBox" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Contenitore Footer -->
    <Border Background="#40000000"
            BorderBrush="#4E111111"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,12,12"
            Padding="38,10,28,10"
            Height="80">

        <Grid Background="Transparent">

            <!-- AREA CONTROLLER A SINISTRA -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="NoControllerBadge"
                        Background="#1AFFFFFF"
                        CornerRadius="14"
                        Padding="12,6">
                    <TextBlock Text="No controller connected"
                               Foreground="#77FFFFFF"
                               FontSize="12"
                               FontWeight="Medium"/>
                </Border>

                <ItemsControl x:Name="ControllersList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- PULSANTE CONTROLLER CON RETTANGOLO SMUSSATO IN HOVER -->
                            <Button Style="{StaticResource Win11ControllerButton}"
                                    ToolTip="{Binding UniqueId}"
                                    Tag="{Binding}"
                                    Click="BtnControllerItem_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{Binding IconImageSource}"
                                           Height="40"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,2,0,0">
                                        <Ellipse Width="5" Height="5" Fill="{Binding Led1}" Margin="1.5,0"/>
                                        <Ellipse Width="5" Height="5" Fill="{Binding Led2}" Margin="1.5,0"/>
                                        <Ellipse Width="5" Height="5" Fill="{Binding Led3}" Margin="1.5,0"/>
                                        <Ellipse Width="5" Height="5" Fill="{Binding Led4}" Margin="1.5,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- MINI-MENU POPUP CON SOLO 2 ICONE (VIBRA / SPEGNI) -->
                <Popup x:Name="ControllerActionPopup"
                       Placement="Top"
                       VerticalOffset="-6"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#F21E1E1E"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <!-- Icona 1: Identifica (Vibrazione) -->
                            <Button x:Name="BtnIdentifyController"
                                    Style="{StaticResource Win11FooterIconButton}"
                                    Width="34" Height="34"
                                    Margin="0,0,4,0"
                                    ToolTip="Identify (Vibrate)"
                                    Click="BtnIdentifyController_Click">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="18"/>
                            </Button>

                            <!-- Icona 2: Spegni Controller -->
                            <Button x:Name="BtnTurnOffController"
                                    Style="{StaticResource Win11FooterIconButton}"
                                    Width="34" Height="34"
                                    Margin="0"
                                    Foreground="#FF6B6B"
                                    ToolTip="Turn Off Controller"
                                    Click="BtnTurnOffController_Click">
                                <ui:SymbolIcon Symbol="Power24" FontSize="18"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- I 4 PULSANTI A DESTRA (Sync, Pin to Taskbar, Settings, Close) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- 1. SYNC -->
                <Button x:Name="BtnSync"
                        Style="{StaticResource Win11FooterIconButton}"
                        ToolTip="Sync Library">
                    <ui:SymbolIcon x:Name="SyncIcon"
                                   Symbol="ArrowSync24"
                                   FontSize="19"
                                   RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform x:Name="SyncRotateTransform" Angle="0"/>
                        </ui:SymbolIcon.RenderTransform>
                    </ui:SymbolIcon>
                </Button>

                <!-- 2. PIN TO TASKBAR -->
                <Button x:Name="BtnPinTaskbar"
                        Style="{StaticResource Win11FooterIconButton}"
                        ToolTip="Pin to Taskbar">
                    <ui:SymbolIcon Symbol="Pin24" FontSize="19"/>
                </Button>

                <!-- 3. SETTINGS -->
                <Button x:Name="BtnSettings"
                        Style="{StaticResource Win11FooterIconButton}"
                        ToolTip="Settings">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="19"/>
                </Button>

                <!-- 4. CLOSE -->
                <Button x:Name="BtnClose"
                        Style="{StaticResource Win11FooterIconButton}"
                        ToolTip="Close App">
                    <ui:SymbolIcon Symbol="Power24" FontSize="19"/>
                </Button>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>