<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GameStartMenu.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- =========================================================
         Shared controller button badge (A / X / Y) shown above card action buttons
         only while a controller is connected.
    ========================================================= -->
    <Style x:Key="GamepadBadgeStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility"
                Value="{Binding IsControllerConnected, RelativeSource={RelativeSource AncestorType=views:LibraryGridView}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="18" Height="18"
                            CornerRadius="9"
                            Background="#EB141414"
                            BorderBrush="{TemplateBinding Foreground}"
                            BorderThickness="1.3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.85"/>
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-0.5,0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         Shared brush: hover border gradient (white diagonal fade)
         Used by all action buttons inside the game card.
    ========================================================= -->
    <LinearGradientBrush x:Key="ButtonHoverBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#88FFFFFF" Offset="0.0"/>
        <GradientStop Color="#22FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- =========================================================
         Shared brush: default button background (semi-transparent dark)
    ========================================================= -->
    <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#66000000"/>

    <!-- =========================================================
         Shared brush: default button border
    ========================================================= -->
    <SolidColorBrush x:Key="ButtonDefaultBorder" Color="#55FFFFFF"/>

    <!-- =========================================================
         PLAY button ControlTemplate  (34x34, rounded rect R=6, green hover)
    ========================================================= -->
    <ControlTemplate x:Key="PlayButtonTemplate" TargetType="Button">
        <Grid Width="34" Height="34">
            <!-- Blurred cover image clipped to rounded rect -->
            <Canvas Width="34" Height="34">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/>
                </Canvas.Clip>
                <Image Source="{Binding CoverImage}"
                       Width="140" Height="210"
                       Stretch="UniformToFill"
                       Canvas.Left="-32" Canvas.Top="-165">
                    <Image.Effect>
                        <BlurEffect Radius="18" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
            </Canvas>
            <!-- Dark veil + border + icon -->
            <Border x:Name="BtnBorder"
                    CornerRadius="6"
                    Background="{StaticResource ButtonDefaultBackground}"
                    BorderBrush="{StaticResource ButtonDefaultBorder}"
                    BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="BorderBrush"
                        Value="{StaticResource ButtonHoverBorderBrush}"/>
                <Setter TargetName="BtnBorder" Property="Background">
                    <Setter.Value>
                        <!-- Green gradient on hover -->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF4CAF50" Offset="0.0"/>
                            <GradientStop Color="#FF2E7D32" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- =========================================================
         PLAY MODDED button ControlTemplate  (34x34, rounded rect R=6, blue hover)
    ========================================================= -->
    <ControlTemplate x:Key="ModButtonTemplate" TargetType="Button">
        <Grid Width="34" Height="34">
            <!-- Blurred cover image clipped to rounded rect -->
            <Canvas Width="34" Height="34">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/>
                </Canvas.Clip>
                <Image Source="{Binding CoverImage}"
                       Width="140" Height="210"
                       Stretch="UniformToFill"
                       Canvas.Left="-53" Canvas.Top="-165">
                    <Image.Effect>
                        <BlurEffect Radius="18" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
            </Canvas>
            <!-- Dark veil + border + icon -->
            <Border x:Name="BtnBorder"
                    CornerRadius="6"
                    Background="{StaticResource ButtonDefaultBackground}"
                    BorderBrush="{StaticResource ButtonDefaultBorder}"
                    BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="BorderBrush"
                        Value="{StaticResource ButtonHoverBorderBrush}"/>
                <Setter TargetName="BtnBorder" Property="Background">
                    <Setter.Value>
                        <!-- Blue gradient on hover -->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF29B6F6" Offset="0.0"/>
                            <GradientStop Color="#FF0288D1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- =========================================================
         INFO button ControlTemplate  (30x30, circle R=15, slate hover)
    ========================================================= -->
    <ControlTemplate x:Key="InfoButtonTemplate" TargetType="Button">
        <Grid Width="30" Height="30">
            <!-- Blurred cover image clipped to circle -->
            <Canvas Width="30" Height="30">
                <Canvas.Clip>
                    <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                </Canvas.Clip>
                <Image Source="{Binding CoverImage}"
                       Width="140" Height="210"
                       Stretch="UniformToFill"
                       Canvas.Left="-93" Canvas.Top="-167">
                    <Image.Effect>
                        <BlurEffect Radius="18" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
            </Canvas>
            <!-- Dark veil + border + icon -->
            <Border x:Name="BtnBorder"
                    CornerRadius="15"
                    Background="{StaticResource ButtonDefaultBackground}"
                    BorderBrush="{StaticResource ButtonDefaultBorder}"
                    BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="BorderBrush"
                        Value="{StaticResource ButtonHoverBorderBrush}"/>
                <Setter TargetName="BtnBorder" Property="Background">
                    <Setter.Value>
                        <!-- Slate gradient on hover -->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF78909C" Offset="0.0"/>
                            <GradientStop Color="#FF455A64" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
