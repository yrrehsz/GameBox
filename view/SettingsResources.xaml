<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Win11-style settings card border -->
    <Style x:Key="Win11SettingsCard" TargetType="Border">
        <Setter Property="Background"       Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush"      Value="#15FFFFFF"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="8"/>
        <Setter Property="Padding"          Value="16,14"/>
        <Setter Property="Margin"           Value="0,0,0,10"/>
    </Style>

    <!-- Reskinned CheckBox as a rectangular tile for overlay selection (235x115) -->
    <Style x:Key="Win11OverlayTileCheckBox" TargetType="CheckBox">
        <Setter Property="Width"      Value="235"/>
        <Setter Property="Height"     Value="115"/>
        <Setter Property="Margin"     Value="0,0,12,12"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="TileBorder"
                            Background="#0DFFFFFF"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="14,10">
                        <Grid>
                            <!-- Priority badge (top-right): shows 1st, 2nd, 3rd or a checkmark when active -->
                            <Border x:Name="CheckBadge"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#60CDFF"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#121212"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Center content: image (187x61) + platform name -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="Background"   Value="#18FFFFFF"/>
                            <Setter TargetName="TileBorder" Property="BorderBrush"  Value="#44FFFFFF"/>
                            <Setter Property="Foreground"                            Value="White"/>
                        </Trigger>

                        <!-- Checked state -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TileBorder" Property="Background"   Value="#2260CDFF"/>
                            <Setter TargetName="TileBorder" Property="BorderBrush"  Value="#60CDFF"/>
                            <Setter TargetName="CheckBadge" Property="Visibility"   Value="Visible"/>
                            <Setter Property="Foreground"                            Value="White"/>
                        </Trigger>

                        <!-- Hover + Checked combined -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TileBorder" Property="Background"   Value="#3060CDFF"/>
                            <Setter TargetName="TileBorder" Property="BorderBrush"  Value="#88DCFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win11-style left navigation radio button -->
    <Style x:Key="Win11NavRadio" TargetType="RadioButton">
        <Setter Property="Height"     Value="40"/>
        <Setter Property="Margin"     Value="0,2"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBorder"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="12,0">
                        <Grid>
                            <!-- Win11-style vertical blue active indicator pill -->
                            <Border x:Name="ActivePill"
                                    Width="3" Height="16"
                                    CornerRadius="1.5"
                                    Background="#60CDFF"
                                    HorizontalAlignment="Left"
                                    Margin="-12,0,0,0"
                                    Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="#12FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBorder"  Property="Background"   Value="#1AFFFFFF"/>
                            <Setter TargetName="ActivePill" Property="Visibility"   Value="Visible"/>
                            <Setter Property="Foreground"                            Value="White"/>
                            <Setter Property="FontWeight"                            Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
