<UserControl x:Class="GameStartMenu.Views.LibraryGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GameStartMenu.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="14,6,6,6"
                  Padding="0,0,8,0">
        <ItemsControl x:Name="GamesGridControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        Each game item is rendered by the self-contained GameCardView.
                        Its routed events (PlayGame, PlayModded, GameInfo) bubble up and are
                        handled by LibraryGridView, which re-exposes them as Action<> events
                        consumed by MainWindow.
                    -->
                    <views:GameCardView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <EventSetter Event="views:GameCardView.PlayGame"   Handler="Card_PlayGame"/>
                    <EventSetter Event="views:GameCardView.PlayModded" Handler="Card_PlayModded"/>
                    <EventSetter Event="views:GameCardView.GameInfo"   Handler="Card_GameInfo"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
