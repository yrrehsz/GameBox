<UserControl x:Class="GameStartMenu.Views.LibraryGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="14,6,6,6"
                  Padding="0,0,8,0">
        <ItemsControl x:Name="GamesGridControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        Wrapper Grid che contiene:
                          Row 0 (210px) - Copertina
                          Row 1 (Auto)  - Barra badge sotto
                        Permette all'overlay Xbox Platinum di stare a cavallo tra le due righe
                        usando Panel.ZIndex elevato e Margin negativo sul bordo inferiore della cover.
                    -->
                    <Grid Width="140"
                          Margin="8,8,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="210"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ======================================================= -->
                        <!-- 1. COPERTINA DEL GIOCO (140x210) CON EFFETTO STEAM GLOSSY & HOVER -->
                        <!-- ======================================================= -->
                        <Border x:Name="CardBorder"
                                Grid.Row="0"
                                Width="140"
                                Height="210"
                                CornerRadius="0"
                                Background="#1E1E1E"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="0"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0.5"
                                MouseMove="CardBorder_MouseMove"
                                MouseLeave="CardBorder_MouseLeave"
                                Panel.ZIndex="0">

                            <!-- Trasformazione per Zoom + Sollevamento della Card -->
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScale"
                                                    ScaleX="1.0"
                                                    ScaleY="1.0"/>
                                    <TranslateTransform x:Name="CardTranslate"
                                                        Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <!-- Ombra esterna che si intensifica in Hover -->
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow"
                                                  BlurRadius="10"
                                                  ShadowDepth="3"
                                                  Direction="270"
                                                  Color="Black"
                                                  Opacity="0"/>
                            </Border.Effect>

                            <!-- Trigger di animazione quando il mouse entra ed esce dalla copertina -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.05"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.05"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-4"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlossyOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.15"/>

                                            <!-- Comparsa della barra inferiore (1/3 della cover) in Hover -->
                                            <DoubleAnimation Storyboard.TargetName="ActionOverlayBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlossyOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.25"/>

                                            <!-- Scomparsa della barra inferiore -->
                                            <DoubleAnimation Storyboard.TargetName="ActionOverlayBar"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Leggero Zoom della card (1.0 -> 1.05) -->
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.05"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.05"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Sollevamento verso l'alto (-4px) -->
                                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-4"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Comparsa del riflesso Glossy -->
                                            <DoubleAnimation Storyboard.TargetName="GlossyOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Ritorno a dimensione normale -->
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Dissolvenza del riflesso Glossy -->
                                            <DoubleAnimation Storyboard.TargetName="GlossyOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <!-- Stile per illuminare il bordo sottile in Hover -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="#88A8D8FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid ClipToBounds="True">
                                <!-- Titolo di fallback se manca la cover -->
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="#88FFFFFF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="10"/>

                                <!-- 1. Immagine di Copertina Principale Nitida -->
                                <Image x:Name="MainCoverImg"
                                       Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- STRATO GLOSSY / RIFLESSO DI LUCE DINAMICO STILE STEAM -->
                                <Canvas IsHitTestVisible="False"
                                        ClipToBounds="True">
                                    <Rectangle x:Name="GlossyOverlay"
                                               Width="260"
                                               Height="320"
                                               Canvas.Left="-60"
                                               Canvas.Top="-180"
                                               Opacity="0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="-28"/>
                                                <TranslateTransform x:Name="GlossTranslate"
                                                                    X="0"
                                                                    Y="0"/>
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#08FFFFFF" Offset="0.35"/>
                                                <GradientStop Color="#38FFFFFF" Offset="0.50"/>
                                                <GradientStop Color="#08FFFFFF" Offset="0.65"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Canvas>

                                <!-- CONTENITORE INVISIBILE DEI PULSANTI (Compare in Hover) -->
                                <Border x:Name="ActionOverlayBar"
                                        Height="45"
                                        Margin="0,0,0,6"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        Opacity="0">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <!-- 1. PULSANTE PLAY STANDARD (Ritaglio geometrico arrotondato perfetto 34x34, R=6) -->
                                        <Button Visibility="{Binding PlayButtonVisibility}"
                                                Cursor="Hand"
                                                Width="34"
                                                Height="34"
                                                Margin="4,0"
                                                ToolTip="Play Game"
                                                Tag="{Binding}"
                                                Click="BtnPlayGame_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="34" Height="34">
                                                        <!-- Ritaglio Geometrico esatto con angoli arrotondati Radius=6 -->
                                                        <Canvas Width="34" Height="34">
                                                            <Canvas.Clip>
                                                                <RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/>
                                                            </Canvas.Clip>
                                                            <Image Source="{Binding CoverImage}"
                                                                   Width="140"
                                                                   Height="210"
                                                                   Stretch="UniformToFill"
                                                                   Canvas.Left="-32"
                                                                   Canvas.Top="-165">
                                                                <Image.Effect>
                                                                    <BlurEffect Radius="18" KernelType="Gaussian"/>
                                                                </Image.Effect>
                                                            </Image>
                                                        </Canvas>

                                                        <!-- Velo scuro fumé + Bordo + Icona nitida -->
                                                        <Border x:Name="BtnBorder"
                                                                CornerRadius="6"
                                                                Background="#66000000"
                                                                BorderBrush="#55FFFFFF"
                                                                BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <!-- Gradiente verde/blu in stile Steam all'hover -->
                                                            <Setter TargetName="BtnBorder" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#88FFFFFF" Offset="0.0"/>
                                                                        <GradientStop Color="#22FFFFFF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="BtnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF4CAF50" Offset="0.0"/>
                                                                        <GradientStop Color="#FF2E7D32" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="Play24" FontSize="17" Foreground="White"/>
                                        </Button>

                                        <!-- 2. PULSANTE PLAY MODDED / EMULATORE (Ritaglio geometrico arrotondato perfetto 34x34, R=6) -->
                                        <Button Visibility="{Binding ModButtonVisibility}"
                                                Cursor="Hand"
                                                Width="34"
                                                Height="34"
                                                Margin="4,0"
                                                ToolTip="{Binding ModDisplayName}"
                                                Tag="{Binding}"
                                                Click="BtnPlayModded_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="34" Height="34">
                                                        <!-- Ritaglio Geometrico esatto con angoli arrotondati Radius=6 -->
                                                        <Canvas Width="34" Height="34">
                                                            <Canvas.Clip>
                                                                <RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/>
                                                            </Canvas.Clip>
                                                            <Image Source="{Binding CoverImage}"
                                                                   Width="140"
                                                                   Height="210"
                                                                   Stretch="UniformToFill"
                                                                   Canvas.Left="-53"
                                                                   Canvas.Top="-165">
                                                                <Image.Effect>
                                                                    <BlurEffect Radius="18" KernelType="Gaussian"/>
                                                                </Image.Effect>
                                                            </Image>
                                                        </Canvas>

                                                        <!-- Velo scuro fumé + Bordo + Icona nitida -->
                                                        <Border x:Name="BtnBorder"
                                                                CornerRadius="6"
                                                                Background="#66000000"
                                                                BorderBrush="#55FFFFFF"
                                                                BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#88FFFFFF" Offset="0.0"/>
                                                                        <GradientStop Color="#22FFFFFF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="BtnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF29B6F6" Offset="0.0"/>
                                                                        <GradientStop Color="#FF0288D1" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="Wrench24" FontSize="17" Foreground="White"/>
                                        </Button>

                                        <!-- 3. PULSANTE INFO (Ritaglio geometrico Circolare perfetto 30x30, R=15) -->
                                        <Button Cursor="Hand"
                                                Width="30"
                                                Height="30"
                                                Margin="4,0"
                                                ToolTip="Game Info &amp; Achievements"
                                                Tag="{Binding}"
                                                Click="BtnGameInfo_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="30" Height="30">
                                                        <!-- Ritaglio Geometrico Circolare perfetto (EllipseGeometry) -->
                                                        <Canvas Width="30" Height="30">
                                                            <Canvas.Clip>
                                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                                                            </Canvas.Clip>
                                                            <Image Source="{Binding CoverImage}"
                                                                   Width="140"
                                                                   Height="210"
                                                                   Stretch="UniformToFill"
                                                                   Canvas.Left="-93"
                                                                   Canvas.Top="-167">
                                                                <Image.Effect>
                                                                    <BlurEffect Radius="18" KernelType="Gaussian"/>
                                                                </Image.Effect>
                                                            </Image>
                                                        </Canvas>

                                                        <!-- Velo scuro fumé + Bordo + Icona nitida -->
                                                        <Border x:Name="BtnBorder"
                                                                CornerRadius="15"
                                                                Background="#66000000"
                                                                BorderBrush="#55FFFFFF"
                                                                BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#88FFFFFF" Offset="0.0"/>
                                                                        <GradientStop Color="#22FFFFFF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="BtnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF78909C" Offset="0.0"/>
                                                                        <GradientStop Color="#FF455A64" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="Info24" FontSize="17" Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. BARRA ICONE COMPLETAMENTO SOTTO LA COVER -->
                        <Border Grid.Row="1"
                                MinHeight="36"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0,0"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Image Source="{Binding SteamRankIcon}"
                                       Visibility="{Binding SteamBadgeVisibility}"
                                       ToolTip="{Binding SteamTooltip}"
                                       Width="{Binding SteamIconSize}"
                                       Height="{Binding SteamIconSize}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <Image Source="{Binding PsRankIcon}"
                                       Visibility="{Binding PsBadgeVisibility}"
                                       ToolTip="{Binding PsTooltip}"
                                       Width="{Binding PsIconSize}"
                                       Height="{Binding PsIconSize}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <Image Source="{Binding XboxRankIcon}"
                                       Visibility="{Binding XboxBadgeVisibility}"
                                       ToolTip="{Binding XboxTooltip}"
                                       Width="{Binding XboxIconSize}"
                                       Height="{Binding XboxIconSize}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================= -->
                        <!-- 3. OVERLAY PLATINUM UNIFICATO (XBOX / PS / STEAM)       -->
                        <!--    Mostra solo l'overlay della piattaforma prioritaria! -->
                        <!-- ======================================================= -->
                        <Grid Grid.Row="0"
                              Visibility="{Binding PlatinumOverlayVisibility}"
                              Panel.ZIndex="10"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,-14">

                            <Image Source="{Binding PlatinumOverlayImage}"
                                   Width="130"
                                   Height="38"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTip="{Binding PlatinumOverlayTooltip}"/>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>