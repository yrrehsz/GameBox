<ui:FluentWindow x:Class="GameStartMenu.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tabs="clr-namespace:GameStartMenu.Views"
                 Title="Settings"
                 Width="820" Height="580"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/assets/app/app_icon.ico"
                 Background="#181818">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared styles: Win11SettingsCard, Win11OverlayTileCheckBox, Win11NavRadio -->
                <ResourceDictionary Source="/view/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="GameBox Settings"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- Main body: left nav rail + content area -->
        <Grid Grid.Row="1" Margin="16,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation rail -->
            <StackPanel Grid.Column="0" Margin="0,4,16,0">

                <RadioButton x:Name="NavLibrary"
                             Style="{StaticResource Win11NavRadio}"
                             IsChecked="True"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Library" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavAddGame"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Add a game" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavController"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Games24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Controller" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavSync"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudSync24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Sync" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavAppearance"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Color24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- Tab content area -->
            <Grid Grid.Column="1" Margin="8,0,0,0">

                <!-- Tab 1: Library -->
                <tabs:LibraryTabView x:Name="PageLibrary"/>

                <!-- Tab 2: Add a Game -->
                <tabs:AddGameTabView x:Name="PageAddGame" Visibility="Collapsed"/>

                <!-- Tab 3: Controller -->
                <tabs:ControllerTabView x:Name="PageController" Visibility="Collapsed"/>

                <!-- Tab 4: Sync -->
                <tabs:SyncTabView x:Name="PageSync" Visibility="Collapsed"/>

                <!-- Tab 5: Appearance -->
                <tabs:AppearanceTabView x:Name="PageAppearance" Visibility="Collapsed"/>

            </Grid>
        </Grid>
    </Grid>

</ui:FluentWindow>
