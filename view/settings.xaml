<ui:FluentWindow x:Class="GameStartMenu.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="820"
                 Height="580"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="#181818">

    <Window.Resources>
        <!-- Stile Card contenitore identico a Impostazioni di Windows 11 -->
        <Style x:Key="Win11SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Stile pulsanti navigazione laterale Windows 11 -->
        <Style x:Key="Win11NavRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,0">
                            <Grid>
                                <!-- Indicatore verticale azzurro stile Win11 -->
                                <Border x:Name="ActivePill"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Background="#60CDFF"
                                        HorizontalAlignment="Left"
                                        Margin="-12,0,0,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DEL TITOLO WINDOWS 11 -->
        <ui:TitleBar Grid.Row="0"
                     Title="GameBox Settings"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- CORPO PRINCIPALE: SIDEBAR + AREA CONTENUTO -->
        <Grid Grid.Row="1" Margin="16,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. SIDEBAR DI NAVIGAZIONE (4 Schede) -->
            <StackPanel Grid.Column="0" Margin="0,4,16,0">
                <RadioButton x:Name="NavLibrary"
                             Style="{StaticResource Win11NavRadio}"
                             IsChecked="True"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Library" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavAddGame"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Add a game" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavController"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Games24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Controller" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavSync"
                             Style="{StaticResource Win11NavRadio}"
                             Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudSync24" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Sync" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 2. AREA CONTENUTO DELLE SCHEDE -->
            <Grid Grid.Column="1" Margin="8,0,0,0">

                <!-- ========================================================= -->
                <!-- SCHEDA 1: LIBRARY (Modifica Eseguibili e Cover dei Giochi) -->
                <!-- ========================================================= -->
                <ScrollViewer x:Name="PageLibrary" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Library Management"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,14"/>

                        <!-- SELETTORE GIOCO: Dropdown + Frecce Prev/Next -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Select Game" Foreground="White" FontWeight="Medium"/>
                                    <TextBlock x:Name="TxtGameCounter" Text="0 / 0" Foreground="#88FFFFFF" FontSize="11"/>
                                </StackPanel>

                                <ComboBox x:Name="CmbGamesList"
                                          Grid.Column="1"
                                          DisplayMemberPath="DisplayTitle"
                                          SelectionChanged="CmbGamesList_SelectionChanged"
                                          Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnPrevGame"
                                               Icon="{ui:SymbolIcon ChevronLeft24}"
                                               ToolTip="Previous game"
                                               Margin="0,0,6,0"
                                               Padding="8"
                                               Click="BtnPrevGame_Click"/>
                                    <ui:Button x:Name="BtnNextGame"
                                               Icon="{ui:SymbolIcon ChevronRight24}"
                                               ToolTip="Next game"
                                               Padding="8"
                                               Click="BtnNextGame_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DETTAGLI GIOCO: Cover a sinistra + Campi Eseguibili a destra -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ANTEPRIMA COVER + PULSANTE CAMBIA COVER -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource Win11SettingsCard}"
                                    Padding="12"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="130" Height="195"
                                            CornerRadius="6"
                                            Background="#141414"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image x:Name="ImgLibraryCoverPreview"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <ui:Button x:Name="BtnChangeCover"
                                               Content="Change Cover"
                                               Icon="{ui:SymbolIcon Image24}"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,10,0,0"
                                               Click="BtnChangeCover_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ESEGUIBILE PRIMARIO E SECONDARIO (MOD/EMULATORE) -->
                            <StackPanel Grid.Column="1">

                                <!-- Card 1: Eseguibile Principale -->
                                <Border Style="{StaticResource Win11SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Main Executable / Launch URL"
                                                   Foreground="White"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Path to the main .exe, .bat, or Steam protocol (e.g. steam://rungameid/...)"
                                                   Foreground="#88FFFFFF"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtMainExecutable"
                                                        Grid.Column="0"
                                                        PlaceholderText="Not configured (Display only)"
                                                        ClearButtonEnabled="True"
                                                        Margin="0,0,8,0"/>
                                            <ui:Button Grid.Column="1"
                                                       Content="Browse..."
                                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                                       Click="BtnBrowseMainExe_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Eseguibile Secondario (Modded / Emulatore) -->
                                <Border Style="{StaticResource Win11SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Secondary Executable (Modded / Emulator)"
                                                   Foreground="White"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Enables the secondary Wrench button on the game cover (e.g. ModEngine, ShadPS4, Ryujinx)"
                                                   Foreground="#88FFFFFF"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtModExecutable"
                                                        Grid.Column="0"
                                                        PlaceholderText="Optional path to modded launcher or script..."
                                                        ClearButtonEnabled="True"
                                                        Margin="0,0,8,0"/>
                                            <ui:Button Grid.Column="1"
                                                       Content="Browse..."
                                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                                       Click="BtnBrowseModExe_Click"/>
                                        </Grid>

                                        <TextBlock Text="Secondary Button Tooltip"
                                                   Foreground="#CCFFFFFF"
                                                   FontSize="12"
                                                   Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtModDisplayName"
                                                    PlaceholderText="Play Modded"/>
                                    </StackPanel>
                                </Border>

                                <!-- Barra inferiore: Delete Game a sinistra + Save Changes a destra -->
                                <Grid Margin="0,4,0,0">
                                    <ui:Button x:Name="BtnDeleteGame"
                                               Content="Delete Game"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Appearance="Danger"
                                               HorizontalAlignment="Left"
                                               Padding="14,8"
                                               Click="BtnDeleteGame_Click"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtSaveLibraryStatus"
                                                   Text="Saved successfully!"
                                                   Foreground="#6CCB5F"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Visibility="Collapsed"/>
                                        <ui:Button x:Name="BtnSaveGameChanges"
                                                   Content="Save Changes"
                                                   Icon="{ui:SymbolIcon Save24}"
                                                   Appearance="Primary"
                                                   Padding="18,8"
                                                   Click="BtnSaveGameChanges_Click"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================= -->
                <!-- SCHEDA 2: ADD A GAME (Aggiunta Nuovo Gioco + Cover Auto/Custom) -->
                <!-- ========================================================= -->
                <ScrollViewer x:Name="PageAddGame" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Add a Game"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,14"/>

                        <!-- Passo 1: Scelta Eseguibile -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="1. Game Executable or Script"
                                           Foreground="White"
                                           FontWeight="Medium"/>
                                <TextBlock Text="Select the .exe, .bat, or shortcut file to launch the game"
                                           Foreground="#88FFFFFF"
                                           FontSize="11"
                                           Margin="0,2,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtNewGameExe"
                                                Grid.Column="0"
                                                PlaceholderText="C:\Games\...\game.exe"
                                                Margin="0,0,8,0"/>
                                    <ui:Button Grid.Column="1"
                                               Content="Browse..."
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Appearance="Primary"
                                               Click="BtnBrowseNewGameExe_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Passo 2: Nome del Gioco (Normalizzato automaticamente) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="2. Game Title"
                                           Foreground="White"
                                           FontWeight="Medium"/>
                                <TextBlock Text="The title will be automatically normalized to match your trophies and cloud data"
                                           Foreground="#88FFFFFF"
                                           FontSize="11"
                                           Margin="0,2,0,10"/>

                                <ui:TextBox x:Name="TxtNewGameTitle"
                                            PlaceholderText="e.g. Elden Ring, Bloodborne, Cyberpunk 2077..."
                                            TextChanged="TxtNewGameTitle_TextChanged"/>

                                <TextBlock x:Name="TxtNormalizedPreview"
                                           Text="Normalized ID: -"
                                           Foreground="#60CDFF"
                                           FontSize="11"
                                           Margin="2,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Passo 3: Opzioni Copertina (Auto-download vs Custom) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoDownloadCover"
                                          Content="Automatically download game cover"
                                          IsChecked="True"
                                          Foreground="White"
                                          FontWeight="Medium"
                                          Checked="ChkAutoDownloadCover_Changed"
                                          Unchecked="ChkAutoDownloadCover_Changed"/>
                                <TextBlock Text="Automatically searches and downloads a 600x900 vertical cover from Steam / SteamGridDB"
                                           Foreground="#88FFFFFF"
                                           FontSize="11"
                                           Margin="28,2,0,0"/>

                                <!-- Pannello Cover Manuale (Visibile solo se il checkbox è deselezionato!) -->
                                <Border x:Name="CustomCoverPanel"
                                        Visibility="Collapsed"
                                        Background="#14FFFFFF"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="60" Height="90"
                                                CornerRadius="4"
                                                Background="#181818"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Left">
                                            <Image x:Name="ImgNewGameCustomCover" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <TextBlock Text="Custom Cover Image" Foreground="White" FontWeight="Medium"/>
                                            <TextBlock x:Name="TxtNewGameCoverPath"
                                                       Text="No image selected (Recommended ratio: 600x900)"
                                                       Foreground="#88FFFFFF"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="Select Image..."
                                                   Icon="{ui:SymbolIcon Image24}"
                                                   VerticalAlignment="Center"
                                                   Click="BtnBrowseNewGameCover_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Pulsante Aggiungi alla Libreria -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock x:Name="TxtAddGameStatus"
                                       Text=""
                                       Foreground="#6CCB5F"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ui:Button x:Name="BtnConfirmAddGame"
                                       Content="Add to Library"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Primary"
                                       Padding="20,9"
                                       Click="BtnConfirmAddGame_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================= -->
                <!-- SCHEDA 3 & 4: PLACEHOLDER PER CONTROLLER E SYNC -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageController" Visibility="Collapsed">
                    <TextBlock Text="Controller Settings" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource Win11SettingsCard}">
                        <TextBlock Text="Controller icon &amp; color customization will be configured in the next step." Foreground="#AAFFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- SCHEDA 4: SYNC (Frequenza di Sync + Tutte le API Key)     -->
                <!-- ========================================================= -->
                <ScrollViewer x:Name="PageSync" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cloud Synchronization"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,14"/>

                        <!-- 1. FREQUENZA DI SINCRONIZZAZIONE + PULSANTE SYNC NOW -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Automatic Sync Frequency"
                                               Foreground="White"
                                               FontWeight="Medium"/>
                                    <TextBlock x:Name="TxtLastSyncInfo"
                                               Text="Last sync: Never"
                                               Foreground="#88FFFFFF"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbSyncFrequency" Width="175" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Every hour" Tag="Hourly"/>
                                        <ComboBoxItem Content="Only on startup" Tag="Startup"/>
                                        <ComboBoxItem Content="Manual only" Tag="Manual"/>
                                    </ComboBox>

                                    <ui:Button x:Name="BtnSyncNowSettings"
                                               Content="Sync Now"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Appearance="Secondary"
                                               Click="BtnSyncNowSettings_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. STEAM (API Key + SteamID64) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Games24" Foreground="#66C0F4" Margin="0,0,8,0"/>
                                    <TextBlock Text="Steam Integration" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="Steam Web API Key (from steamcommunity.com/dev/apikey)"
                                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtSteamApiKey"
                                                PlaceholderText="Enter your 32-character Steam API Key..."
                                                Margin="0,0,0,10"/>

                                <TextBlock Text="SteamID64 (17-digit profile ID)"
                                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtSteamId64"
                                            PlaceholderText="e.g. 76561198000000000"
                                            ClearButtonEnabled="True"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. PLAYSTATION NETWORK (NPSSO Token) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Trophy24" Foreground="#0070D1" Margin="0,0,8,0"/>
                                    <TextBlock Text="PlayStation Network (PSN)" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="PSN NPSSO Token (64-character token from ca.account.sony.com/api/v1/ssocookie)"
                                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtPsnNpsso"
                                                PlaceholderText="Enter your 64-character NPSSO token..."/>
                            </StackPanel>
                        </Border>

                        <!-- 4. XBOX LIVE (OpenXBL API Key) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Sparkle24" Foreground="#107C10" Margin="0,0,8,0"/>
                                    <TextBlock Text="Xbox Network (OpenXBL)" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="OpenXBL API Key (from xbl.io)"
                                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtOpenXblApiKey"
                                                PlaceholderText="Enter your OpenXBL API Key..."/>
                            </StackPanel>
                        </Border>

                        <!-- 5. STEAMGRIDDB (Per Copertine Automatiche Giochi Non-Steam/PS/Xbox) -->
                        <Border Style="{StaticResource Win11SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Image24" Foreground="#E6A100" Margin="0,0,8,0"/>
                                    <TextBlock Text="SteamGridDB (High-Res 600x900 Covers)" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="SteamGridDB API Key (from steamgriddb.com/profile/preferences/api)"
                                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtSteamGridDbApiKey"
                                                PlaceholderText="Enter your SteamGridDB API Key..."/>
                            </StackPanel>
                        </Border>

                        <!-- PULSANTE SALVA IMPOSTAZIONI SYNC -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
                            <TextBlock x:Name="TxtSaveSyncStatus"
                                       Text="Sync settings saved!"
                                       Foreground="#6CCB5F"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="Collapsed"/>
                            <ui:Button x:Name="BtnSaveSyncSettings"
                                       Content="Save Sync Settings"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Appearance="Primary"
                                       Padding="18,8"
                                       Click="BtnSaveSyncSettings_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>