<Window x:Class="GameStartMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:GameStartMenu.Views"
        Title="GameStartMenu"
        Width="970"
        Height="820"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Icon="pack://application:,,,/assets/app/app_icon.ico"
        Deactivated="Window_Deactivated">

    <Border CornerRadius="12"
            Background="#01FFFFFF"
            BorderBrush="#33FFFFFF"
            BorderThickness="0">

        <Grid x:Name="MainContentGrid" Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" Y="40"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <views:HeaderView Grid.Row="0" x:Name="HeaderView"/>

            <!-- 2. GRIGLIA LIBRERIA -->
            <views:LibraryGridView Grid.Row="1" x:Name="LibraryView"/>

            <!-- 3. FOOTER -->
            <views:FooterView Grid.Row="2" x:Name="FooterView"/>
        </Grid>
    </Border>
</Window>