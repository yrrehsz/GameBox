<Window x:Class="GameStartMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameStartMenu.Views"
        Title="GameStartMenu"
        Width="970"
        Height="820"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/assets/app/app_icon.ico"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <!-- Nearly transparent background (#01FFFFFF) is required for WPF hit-testing over acrylic blur -->
    <Border CornerRadius="12" Background="#01FFFFFF">
        <Grid x:Name="MainContentGrid" Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" Y="40"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <views:HeaderView Grid.Row="0" x:Name="HeaderView"/>

            <!-- Game Library Grid -->
            <views:LibraryGridView Grid.Row="1" x:Name="LibraryView"/>

            <!-- Footer -->
            <views:FooterView Grid.Row="2" x:Name="FooterView"/>
        </Grid>
    </Border>
</Window>
